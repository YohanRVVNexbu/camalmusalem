APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Salesforce Toyota — Mulesoft Dealer Experience API
# En PRD cada sucursal tiene un par de credenciales propio (no usar las genéricas).
# En UAT/QAS había un solo par genérico (SALESFORCE_CLIENT_ID/SECRET) que aplicaba
# a ambos dealers — el cliente cae al par genérico si no hay específico.
SALESFORCE_ENABLED=false
SALESFORCE_OAUTH_URL=
SALESFORCE_API_BASE_URL=
SALESFORCE_SCOPE=DEALER

# Credenciales genéricas (UAT). Dejar vacías en PRD.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Credenciales por sucursal (PRD). El dealer_id se mapea desde
# branches.salesforce_dealer_id: 100068 = La Serena, 100069 = Ovalle.
SALESFORCE_CLIENT_ID_LS=
SALESFORCE_CLIENT_SECRET_LS=
SALESFORCE_CLIENT_ID_OVA=
SALESFORCE_CLIENT_SECRET_OVA=

# Compliance — correo donde llegan las denuncias de Ley 20.393 y Ley Karin.
# Si quieres un correo distinto para Karin, define COMPLIANCE_ENCARGADO_EMAIL_KARIN.
COMPLIANCE_ENCARGADO_EMAIL=
#COMPLIANCE_ENCARGADO_EMAIL_KARIN=

# Notificaciones a equipos internos cuando se envía un formulario público.
# Defaults toman los correos del PDF "Contacto Correos Electronicos" entregado
# por el cliente. Sobreescribir solo cuando el cliente rote estos correos.
#NOTIFY_VEHICULOS_NUEVOS=info@camalmusalem.cl
#NOTIFY_VEHICULOS_SEMINUEVOS=seminuevos@camalmusalem.cl
#NOTIFY_CONTACTO=info@camalmusalem.cl
#NOTIFY_KINTO=info@camalmusalem.cl
#NOTIFY_REPUESTOS_LS=repuestosls@camalmusalem.cl
#NOTIFY_REPUESTOS_OVA=repuestosova@camalmusalem.cl
#NOTIFY_ACCESORIOS_LS=repuestosls@camalmusalem.cl
#NOTIFY_ACCESORIOS_OVA=repuestosova@camalmusalem.cl
#NOTIFY_MANTENCION_LS=stecnicols@camalmusalem.cl
#NOTIFY_MANTENCION_OVA=stecnicoova@camalmusalem.cl

# Google Tag Manager. Pega aquí el ID del contenedor (formato GTM-XXXXXXX).
# Si lo dejas vacío, no se inyecta ningún script de GTM en el sitio.
GTM_ID=
